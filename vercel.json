{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix apps/web",
  "buildCommand": "npm run build --prefix apps/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://webdataos.nov-tia.com/health"
    },
    {
      "source": "/ready",
      "destination": "https://webdataos.nov-tia.com/ready"
    },
    {
      "source": "/workspaces",
      "destination": "https://webdataos.nov-tia.com/workspaces"
    },
    {
      "source": "/workspaces/:path*",
      "destination": "https://webdataos.nov-tia.com/workspaces/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://webdataos.nov-tia.com/auth/:path*"
    },
    {
      "source": "/agent/:path*",
      "destination": "https://webdataos.nov-tia.com/agent/:path*"
    },
    {
      "source": "/monitor/:path*",
      "destination": "https://webdataos.nov-tia.com/monitor/:path*"
    },
    {
      "source": "/chat/:path*",
      "destination": "https://webdataos.nov-tia.com/chat/:path*"
    },
    {
      "source": "/gateway/:path*",
      "destination": "https://webdataos.nov-tia.com/gateway/:path*"
    },
    {
      "source": "/intelligence/:path*",
      "destination": "https://webdataos.nov-tia.com/intelligence/:path*"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://webdataos.nov-tia.com/demo/:path*"
    },
    {
      "source": "/graph/:path*",
      "destination": "https://webdataos.nov-tia.com/graph/:path*"
    },
    {
      "source": "/llm/:path*",
      "destination": "https://webdataos.nov-tia.com/llm/:path*"
    },
    {
      "source": "/transcriptions/:path*",
      "destination": "https://webdataos.nov-tia.com/transcriptions/:path*"
    },
    {
      "source": "/memory/:path*",
      "destination": "https://webdataos.nov-tia.com/memory/:path*"
    },
    {
      "source": "/workflows/:path*",
      "destination": "https://webdataos.nov-tia.com/workflows/:path*"
    },
    {
      "source": "/triggerware/:path*",
      "destination": "https://webdataos.nov-tia.com/triggerware/:path*"
    },
    {
      "source": "/context/:path*",
      "destination": "https://webdataos.nov-tia.com/context/:path*"
    },
    {
      "source": "/actions/:path*",
      "destination": "https://webdataos.nov-tia.com/actions/:path*"
    },
    {
      "source": "/outcomes/:path*",
      "destination": "https://webdataos.nov-tia.com/outcomes/:path*"
    },
    {
      "source": "/runs",
      "destination": "https://webdataos.nov-tia.com/runs"
    },
    {
      "source": "/runs/:path*",
      "destination": "https://webdataos.nov-tia.com/runs/:path*"
    },
    {
      "source": "/metrics",
      "destination": "https://webdataos.nov-tia.com/metrics"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
