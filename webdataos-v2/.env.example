# Runtime
APP_ENV=development
LOG_LEVEL=INFO
MOCK_BRIGHTDATA=true

# API security
# For local demos leave false. For staging/production set true and provide API_KEYS.
API_AUTH_ENABLED=false
API_KEYS=dev-local-key-change-me
API_KEY_HEADER_NAME=X-API-Key
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,api,web
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
REQUEST_BODY_MAX_BYTES=2000000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/webdata
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/webdata

# Bright Data - fill later
MOCK_BRIGHTDATA=false
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ENDPOINT=https://api.brightdata.com/request
BRIGHTDATA_WEB_SCRAPER_ENDPOINT=https://api.brightdata.com/datasets/v3/scrape?dataset_id=YOUR_DATASET_ID&format=json
BRIGHTDATA_WEB_UNLOCKER_ENDPOINT=https://api.brightdata.com/request
# The browser endpoint is a WebSocket URL and requires browser automation support.
# This app currently does not POST to wss:// endpoints for Browser API.
# Example: wss://<zone>:<password>@brd.superproxy.io:9222
BRIGHTDATA_SCRAPING_BROWSER_ENDPOINT=wss://<zone>:<password>@brd.superproxy.io:9222
# MCP is an SSE/stream endpoint and is fetched via GET.
BRIGHTDATA_MCP_ENDPOINT=https://mcp.brightdata.com/sse?token=<your-token>&groups=advanced_scraping
DEFAULT_COUNTRY=us
REQUEST_TIMEOUT_SECONDS=30
MAX_RECOVERY_ATTEMPTS=4
RETRY_ATTEMPTS=3

# LLM providers - fill later
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Neo4j - optional
NEO4J_ENABLED=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password12345

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true

# Partner runtime integrations
SPEECHMATICS_API_KEY=
SPEECHMATICS_ENDPOINT=
COGNEE_API_KEY=
COGNEE_ENDPOINT=
TRIGGERWARE_API_KEY=
TRIGGERWARE_ENDPOINT=
