# ═══════════════════════════════════════════════════════════════
# WebDataOS v3 - Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy to .env: cp .env.example .env
# Every variable has a sensible default — fill only what you need.

# ── Runtime ──
APP_ENV=development
LOG_LEVEL=INFO
MOCK_BRIGHTDATA=true

# ── API Security ──
API_AUTH_ENABLED=false
API_KEYS=dev-local-key-change-me
API_KEY_HEADER_NAME=X-API-Key
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,api,web
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
REQUEST_BODY_MAX_BYTES=2000000

# ── Database (defaults work with Docker Compose) ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/webdata
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/webdata
POSTGRES_PASSWORD=postgres

# ── OpenAI (enables LLM synthesis + semantic memory search) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Bright Data (live web retrieval; mock mode when empty) ──
# Get your API key from: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=
# Unified API endpoint (SERP + Web Unlocker both use this)
BRIGHTDATA_API_ENDPOINT=https://api.brightdata.com/request
# Web Scraper API uses a different endpoint
BRIGHTDATA_SCRAPER_ENDPOINT=https://api.brightdata.com/datasets/v3/trigger
# Zone names (from your Bright Data dashboard)
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_WEB_UNLOCKER_ZONE=web_unlocker2
BRIGHTDATA_SCRAPING_BROWSER_ZONE=scraping_browser2
# Scraping Browser (WebSocket — uses zone credentials, not API key)
BRIGHTDATA_SCRAPING_BROWSER_ENDPOINT=wss://brd.superproxy.io:9222
BRIGHTDATA_BROWSER_USER=
BRIGHTDATA_BROWSER_PASSWORD=
BRIGHTDATA_MCP_ENDPOINT=
# General settings
DEFAULT_COUNTRY=us
REQUEST_TIMEOUT_SECONDS=30
MAX_RECOVERY_ATTEMPTS=4
RETRY_ATTEMPTS=3

# ── Cognee (knowledge graph memory; local mode when empty) ──
# Install: pip install cognee (free, open source)
# Cloud mode: fill both fields below
COGNEE_ENDPOINT=
COGNEE_API_KEY=

# ── Neo4j (entity graph; disabled by default) ──
# Free tier: https://neo4j.com/cloud/aura-free
# Up to 200K nodes, 400K relationships, $0
NEO4J_ENABLED=false
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Speechmatics ──
SPEECHMATICS_API_KEY=
SPEECHMATICS_ENDPOINT=

# ── TriggerWare ──
TRIGGERWARE_API_KEY=
TRIGGERWARE_ENDPOINT=

# ── Web UI ──
# Set to your server's public URL for Vultr deployment
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=dev-local-key-change-me

# ── Observability (optional) ──
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true
